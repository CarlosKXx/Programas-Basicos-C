#include <stdio.h>

int soma(int a, int b) {
    return a + b;
}
int sub(int a, int b) {
    return a - b;
}
int mult(int a, int b) {
    return a * b;
}
int div(int a, int b) {
    return a / b;
}

int main()
{
    int num1, num2, result=0;
    char op, entrada;
 
    entrada = 'C';
 
    while (entrada != 'f' && entrada != 'F') {
        if (entrada == '+' || entrada == '-' || entrada == '*' || entrada == '/') {
            num1 = result;
            op = entrada;
            printf("Digite o segundo numero: ");
            scanf("%i", &num2);
            printf("Usando o resultado anterior: %i %c %i\n ", num1, op, num2);
        }
        else if (entrada == 'c' || entrada == 'C') {
            printf("\nDigite o primeiro numero: ");
            scanf("%i", &num1);
            printf("Digite o operador (+, -, *, /): ");
            scanf(" %c", &op);
            printf("Digite o segundo numero: ");
            scanf("%i", &num2);
        }
        else {
            printf("\nErro: opção inválida!\n");
            printf("\nPara continuar o cálculo (+|-|*|/)\nPara limpar (C)\nPara fechar (F)\nInsira: ");
            scanf(" %c", &entrada);
            continue;
        }
        switch (op) {
            case '+':
                result = soma(num1, num2);
                break;
 
            case '-':
                result = sub(num1, num2);
                break;
 
            case '*':
                result = mult(num1, num2);
                break;
 
            case '/':
                if (num2 == 0) {
                printf("Erro: divisao por zero!\n");
                continue;
                }
                result = div(num1, num2);
                break;
 
            default:
                printf("Erro: operador invalido!\n");
                continue;
        
 
       
        }
 
        printf("Resultado: %i\n", result);
 
        printf("\nPara continuar o cálculo (+|-|*|/)\nPara limpar (C)\nPara fechar (F)\nInsira: ");
        scanf(" %c", &entrada);
       
    }
 
    printf("Programa finalizado!\n");
 
    return 0;
}
