#include <stdio.h>
#include <string.h>
#include <stdlib.h>

float calct(int a, float b[]) {
    int i;
    float c=0;
    for (i = 0; i < a; i++) {
        c += b[i];
    }
    return c;
}

float ler_float() {
    char buffer[50];
    int i;
    fgets(buffer, sizeof(buffer), stdin);
    for (i = 0; buffer[i] != '\0'; i++) {
        if (buffer[i] == ',') {
            buffer[i] = '.';
            break;
        }
    }
    return atof(buffer);
}

int main()
{
    int i, quantidade=0;
    printf("Digite a quantidade de vendas: ");
    scanf("%d", &quantidade);
    while (getchar() != '\n'); 

    if (quantidade <= 0) {
        printf("Quantidade inválida!\n");
        return 1;
    }
    float v[quantidade],total=0,media=0,bonus=0,premio=0;

    for (i = 0; i < quantidade; i++) {
        printf("Digite o valor da %d° venda: ", i+1);
        v[i] = ler_float();
    }
    printf("\n====== VENDAS INFORMADAS =====\n");
    for (i = 0; i < quantidade; i++) {
        printf("%d° Venda: R$ %.2f\n", i+1, v[i]);
    }
    printf("==============================\n");
    total = calct(quantidade, v);
    media = (total / quantidade);
    bonus = (media * 0.1);

    if (media > 5000) {
        premio = 1000;
    }
    else {
        premio = 0;
    }
    printf("\n====== RESULTADO DAS VENDAS =====\n");
    printf("Total das Vendas: R$ %.2f\n", total);
    printf("--------------------\n");
    printf("Média das Vendas: R$ %.2f\n", media);
    printf("--------------------\n");
    printf("Bônus Recebido: R$ %.2f\n", bonus);
    printf("--------------------\n");
    if (premio == 0) {
        printf("Prêmio Recebido: R$ %.2f\n", premio);
        printf("Se dedique um pouco mais!\n");
        printf("--------------------\n");
    }
    else {
        printf("Prêmio Recebido: R$ %.2f\n", premio);
        printf("Parabéns, continue assim!!!\n");
        printf("--------------------\n");
    }
    printf("Total Recebido: R$ %.2f\n", total+bonus+premio);
    printf("===============================");

    return 0;
}
